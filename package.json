{
	"name": "knapper-obsidian-simulator",
	"version": "0.1.1",
	"description": "Run built Obsidian plugins in a persistent browser simulator.",
	"private": false,
	"license": "MIT",
	"author": "Bearfire",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paperkeel/knapper-obsidian-simulator.git"
	},
	"homepage": "https://github.com/paperkeel/knapper-obsidian-simulator#readme",
	"bugs": {
		"url": "https://github.com/paperkeel/knapper-obsidian-simulator/issues"
	},
	"keywords": [
		"knapper",
		"obsidian",
		"plugin-development",
		"simulator"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"knapper-obsidian-simulator": "dist/package/cli/bin.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/package/index.d.mts",
			"import": "./dist/package/index.mjs"
		},
		"./theme/*.json": "./src/theme/fixtures/*.json"
	},
	"files": [
		"dist",
		"src/theme/fixtures"
	],
	"scripts": {
		"dev": "vp dev --port 3000",
		"build": "pnpm run build:app && pnpm run build:package",
		"build:app": "vp build",
		"build:package": "vp pack src/index.ts src/cli/bin.ts --out-dir dist/package --dts --format esm",
		"prepack": "pnpm run build",
		"preview": "vp preview",
		"test": "vp test run",
		"lint": "vp lint",
		"format": "vp fmt",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"typecheck": "vp check --no-fmt --no-lint",
		"theme:capture": "node scripts/theme/capture-knapper.mjs",
		"theme:validate": "node scripts/theme/validate-theme.mjs src/theme/fixtures/default-light.json && node scripts/theme/validate-theme.mjs src/theme/fixtures/default-dark.json",
		"icons:generate": "node scripts/icons/generate-lucide-nodes.mjs",
		"ci": "pnpm run check && pnpm run test && pnpm run build"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/router-plugin": "latest",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.18.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "latest",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"jsdom": "^28",
		"typescript": "^6",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.22.0",
			"onFail": "download"
		}
	}
}
